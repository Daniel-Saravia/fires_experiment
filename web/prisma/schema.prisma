// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id       Int      @id @default(autoincrement())
  title    String
  location String
  datetime DateTime
  channel  String
  status   String

  @@unique([title, location, datetime, channel, status], map: "events_unique_constraint")
  @@index([datetime], map: "events_datetime_idx")
  @@map("events")
}
