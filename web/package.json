{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape": "tsx --env-file=.env src/worker/scraper.ts",
    "dev:full": "concurrently -k -n \"web,scraper\" -c \"blue,green\" \"npm run dev\" \"npm run scrape\"",
    "db:import": "python3 scripts/migrate_sqlite.py --force"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "cheerio": "^1.1.2",
    "date-fns": "^4.1.0",
    "next": "15.5.4",
    "playwright": "^1.56.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prisma": "^6.17.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
